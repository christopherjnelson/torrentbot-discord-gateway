{
  "name": "torrentbot-discord-gateway",
  "version": "0.1.0-beta",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "discord:register": "node --env-file-if-exists=.dev.vars scripts/register-commands.mjs",
    "discord:unregister": "node --env-file-if-exists=.dev.vars scripts/register-commands.mjs --unregister",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  }
}
