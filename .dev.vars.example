# Copy to .dev.vars and fill in real values. Never commit .dev.vars.

# Discord application public key (Discord Developer Portal -> General Information)
DISCORD_PUBLIC_KEY=replace-me
# Discord application (client) ID - used by the command registration script
DISCORD_APPLICATION_ID=replace-me
# Discord bot token - used by the command registration script only
DISCORD_BOT_TOKEN=replace-me
# Development guild (server) ID for guild-scoped command registration
DISCORD_GUILD_ID=replace-me
# Prowlarr API key (Prowlarr -> Settings -> General -> Security -> API Key)
# - used for /search and /api/search
PROWLARR_API_KEY=replace-me
# TMDB API read access token - used only for /search movie and /search tv
TMDB_READ_ACCESS_TOKEN=replace-me
# Prowlarr base URL - required for /search and /api/search
PROWLARR_URL=https://prowlarr.example.com
# TorBox API key (https://torbox.app/settings) - used for /add and /status
TORBOX_API_KEY=replace-me
# Bearer token required for the internal /api/* routes (generate a long random string)
INTERNAL_API_TOKEN=replace-me
# Comma-separated Discord guild (server) IDs whose members may run /search,
# /add, /status, and the search-result selection flow. Each entry must be a
# snowflake-style decimal string. Missing/empty/malformed denies all Discord
# TorBox access. Treated as a Worker secret so real guild IDs stay out of
# tracked files; set the production value with
# `npx wrangler secret put TORBOX_ALLOWED_GUILD_IDS`.
TORBOX_ALLOWED_GUILD_IDS=
# Secret used to sign Discord component payloads (generate with: openssl rand -hex 32)
COMPONENT_SIGNING_SECRET=replace-me
# Optional: bound the TorBox readiness poll after adding a torrent
# (defaults: 2500 ms between polls, 7 attempts max, ~15-20s total window)
# TORBOX_POLL_INTERVAL_MS=2500
# TORBOX_POLL_MAX_ATTEMPTS=7
