{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "torrentbot-discord-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret configuration. TORBOX_POLL_* bound the readiness check after
	// adding a torrent
	// (maxAttempts x intervalMs ~= 15-20s total).
	//
	// TORBOX_ALLOWED_GUILD_IDS is intentionally NOT a var here: it is a
	// secret binding (see `secrets` below) so that real guild IDs never
	// land in tracked files. Set it with
	// `npx wrangler secret put TORBOX_ALLOWED_GUILD_IDS` (comma-separated).
	"vars": {
		"UPSTREAM_TIMEOUT_MS": "10000",
		"TORBOX_POLL_INTERVAL_MS": "2500",
		"TORBOX_POLL_MAX_ATTEMPTS": "7"
	},
	// Secret bindings the Worker reads at runtime. Set values with
	// `wrangler secret put <NAME>` (production) or in `.dev.vars` (local dev).
	// PROWLARR_URL is the base URL of the Prowlarr instance backing /search and
	// /api/search. It is kept as a secret to avoid exposing private hostnames.
	// TMDB_READ_ACCESS_TOKEN is sent only as a Bearer header for movie/TV
	// search and details; /search general never reads or sends it.
	// TORBOX_ALLOWED_GUILD_IDS is an optional comma-separated list of Discord
	// guild (server) IDs whose members may run /search, /add, /status, and
	// the search-result selection flow. Each entry must be a snowflake-style
	// decimal string. Missing/empty/malformed denies all Discord TorBox access.
	"secrets": {
		"required": [
			"DISCORD_PUBLIC_KEY",
			"PROWLARR_API_KEY",
			"PROWLARR_URL",
			"TMDB_READ_ACCESS_TOKEN",
			"TORBOX_API_KEY",
			"INTERNAL_API_TOKEN",
			"COMPONENT_SIGNING_SECRET",
			"TORBOX_ALLOWED_GUILD_IDS"
		]
	}
}
