{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "torrentbot-discord-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"secrets": {
		"required": ["DISCORD_PUBLIC_KEY"]
	}
}