{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "torrentbot-discord-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret configuration. Comma-separated Discord guild (server) IDs
	// whose members may run /search, /add, /status, and the search-result
	// selection flow. Empty means nobody is authorized. Each entry must be
	// a snowflake-style decimal string. PROWLARR_URL is the base URL of the
	// Prowlarr instance backing /search and /api/search. TORBOX_POLL_*
	// bound the readiness check after adding a torrent
	// (maxAttempts x intervalMs ~= 15-20s total).
	"vars": {
		"TORBOX_ALLOWED_GUILD_IDS": "",
		"UPSTREAM_TIMEOUT_MS": "10000",
		"PROWLARR_URL": "https://prowlarr.chris.guru",
		"TORBOX_POLL_INTERVAL_MS": "2500",
		"TORBOX_POLL_MAX_ATTEMPTS": "7"
	},
	// Secret bindings the Worker reads at runtime. Set values with
	// `wrangler secret put <NAME>` (production) or in `.dev.vars` (local dev).
	"secrets": {
		"required": [
			"DISCORD_PUBLIC_KEY",
			"PROWLARR_API_KEY",
			"TORBOX_API_KEY",
			"INTERNAL_API_TOKEN",
			"COMPONENT_SIGNING_SECRET"
		]
	}
}