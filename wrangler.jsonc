{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "torrentbot-discord-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-19",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Non-secret configuration. Comma-separated Discord user IDs allowed to run
	// /add and /status. Empty means nobody is authorized.
	"vars": {
		"TORBOX_ALLOWED_USER_IDS": "",
		"UPSTREAM_TIMEOUT_MS": "10000"
	},
	// Secret bindings the Worker reads at runtime. Set values with
	// `wrangler secret put <NAME>` (production) or in `.dev.vars` (local dev).
	"secrets": {
		"required": [
			"DISCORD_PUBLIC_KEY",
			"VOYAGER_API_KEY",
			"TORBOX_API_KEY",
			"INTERNAL_API_TOKEN"
		]
	}
}